#!/usr/bin/env sh
# Инструмент правил документации для любого агента и человека: ./tools/doc route|next|diagram|pre|post|check|staged|generated|rnd …
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PY="python3"; command -v python3 >/dev/null 2>&1 || PY="python"
[ -x "$ROOT/html-view/.venv/bin/python" ] && PY="$ROOT/html-view/.venv/bin/python"
[ -x "$ROOT/html-view/.venv/Scripts/python.exe" ] && PY="$ROOT/html-view/.venv/Scripts/python.exe"
PYTHONIOENCODING=utf-8 exec "$PY" "$ROOT/html-view/doctool.py" "$@"
