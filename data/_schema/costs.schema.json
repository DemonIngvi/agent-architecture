{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Единица «costs»",
 "description": "Единица data/ вида «costs». Генерируется: python html-view/doctool.py yaml-schema (не править руками).",
 "type": "object",
 "properties": {
  "costs": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "date": {
      "type": "string",
      "pattern": "^(?:\\d{4}-\\d{2}-\\d{2})$"
     },
     "process": {
      "type": "string",
      "pattern": "^(?:[a-z0-9-]+)$"
     },
     "methodology": {
      "type": "string"
     },
     "units": {
      "type": "integer"
     },
     "unit": {
      "type": "string"
     },
     "tokens": {
      "type": "integer"
     },
     "model": {
      "type": "string"
     },
     "minutes": {
      "type": "integer"
     },
     "expected": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "note": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "date",
     "process",
     "methodology",
     "units",
     "unit",
     "tokens"
    ]
   }
  }
 },
 "additionalProperties": false,
 "required": [
  "costs"
 ]
}
